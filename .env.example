# ---------------------------------------------------------------------------
# AICTE Approval Operations Intelligence Platform — SIH26262 Prototype
# Copy to .env (backend) and fill values. NEVER commit real secrets.
# All values below are LOCAL DEMO placeholders, not production credentials.
# ---------------------------------------------------------------------------

# --- Core backend ---
APP_NAME="AICTE Approval Operations Intelligence Platform"
PROTOTYPE_LABEL="SIH26262 Prototype"
ENVIRONMENT=development        # development | testing
API_HOST=127.0.0.1
API_PORT=8000

# Allowed frontend origins (comma-separated) for CORS
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Default: local SQLite demo database (no server needed).
SQLALCHEMY_DATABASE_URI=sqlite:///./data/aicte_platform.db
# For real PostgreSQL via docker-compose (recommended for evaluation):
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg://aicte:aicte@localhost:5432/aicte
DB_ECHO=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_LOCAL_DEV_ONLY
# Access-token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=180

# --- Object storage ---
# LOCAL: files stored on disk under ./data/uploads  (default, needs no setup)
# S3/MinIO: set S3_ENABLED=true and point to an S3-compatible endpoint.
S3_ENABLED=false
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=aicte-documents

# --- Background workers ---
# Local demo runs jobs in-process; set CELERY_BROKER_URL for the docker-compose stack.
CELERY_BROKER_URL=redis://localhost:6379/0
JOB_MODE=inprocess              # inprocess | celery

# --- Email (SMTP) ---
# Leave empty to run email in "console" mode (messages logged, marked simulated).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AICTE Ops Platform <no-reply@example.local>"

# --- AI provider (optional; core workflow must run without it) ---
# Any OpenAI-compatible API. Leave empty to disable AI features,
# which then surface a clear "not configured" message.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=

# --- OCR (optional extras) ---
# pdfplumber is installed by default. Tesseract OCR additionally requires the
# tesseract binary on the host; pytesseract degrades gracefully when absent.
TESSERACT_CMD=
